rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed(){return request.auth != null;}
    function admin(){return signed() && request.auth.token.email != null && (request.auth.token.email=="028riu@gmail.com" || request.auth.token.email=="tu0ngtun2gsahur@gmail.com" || request.auth.token.email=="linh085760@gmail.com" || request.auth.token.email=="linh085760@stu.vinschool.edu.vn" || request.auth.token.email=="minh037199@stu.vinschool.edu.vn" || request.auth.token.email=="tran034866@stu.vinschool.edu.vn" || request.auth.token.email=="phuong026443@stu.vinschool.edu.vn");}
    function owner(uid){return signed() && request.auth.uid==uid;}

    match /users/{uid} {
      allow read: if signed();
      allow create,update: if admin() || owner(uid);
      allow delete: if admin();
      match /homeworkProgress/{id}{allow read,create,update,delete:if admin()||owner(uid);}
      match /achievements/{id}{allow read,create,update,delete:if admin()||owner(uid);}
      match /inventory/{id}{allow read,create,update,delete:if admin()||owner(uid);}
      match /settings/{id}{allow read,create,update,delete:if admin()||owner(uid);}
    }

    match /chat_profiles/{uid} {
      allow read: if signed();
      allow create,update: if owner(uid);
      allow delete: if admin() || owner(uid);
    }

    match /presence/{uid} {
      allow read: if signed();
      allow create,update: if owner(uid);
      allow delete: if owner(uid);
    }

    match /chats/{chatId} {
      allow read: if signed() && (chatId=="all_members" || (resource.data.members is list && request.auth.uid in resource.data.members));
      allow create: if signed() && (
        chatId=="all_members" ||
        (request.resource.data.type=="private" && request.resource.data.members is list && request.resource.data.members.size()==2 && request.auth.uid in request.resource.data.members)
      );
      allow update: if signed() && (
        chatId=="all_members" ||
        (
          resource.data.type=="private" &&
          resource.data.members is list &&
          request.resource.data.members is list &&
          resource.data.members.size()==2 && request.resource.data.members.size()==2 &&
          request.auth.uid in resource.data.members &&
          (
            (request.resource.data.members[0]==resource.data.members[0] && request.resource.data.members[1]==resource.data.members[1]) ||
            (request.resource.data.members[0]==resource.data.members[1] && request.resource.data.members[1]==resource.data.members[0])
          )
        )
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signed() && (chatId=="all_members" || (get(/databases/$(database)/documents/chats/$(chatId)).data.members is list && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members));
        allow create: if signed()
          && (chatId=="all_members" || (get(/databases/$(database)/documents/chats/$(chatId)).data.members is list && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members))
          && request.resource.data.senderId==request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size()<=2000;
        allow update,delete: if false;
      }
    }

    match /subjects/{id}{allow read:if true;allow create,update,delete:if admin();}
    match /homework/{id}{allow read:if true;allow create,update,delete:if admin();}
    match /settings/{id}{allow read:if true;allow create,update,delete:if admin();}
    match /achievements/{id}{allow read:if true;allow create,update,delete:if admin();}
    match /items/{id}{allow read:if true;allow create,update,delete:if admin();}
    match /pets/{id}{allow read:if true;allow create,update,delete:if admin();}
    match /themes/{id}{allow read:if true;allow create,update,delete:if admin();}
    match /bme_homework/{id}{allow read:if true;allow create,update,delete:if admin();}
    match /settings/directNotification{allow read:if true;allow create,update,delete:if admin();}
    match /class_schedule/{id}{allow read:if true;allow create,update,delete:if admin();}
    match /{document=**}{allow read,write:if false;}
  }
}