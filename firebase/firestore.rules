rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null && (
        request.auth.token.email == "028riu@gmail.com" ||
        request.auth.token.email == "tu0ngtun2gsahur8@gmail.com" ||
        request.auth.token.email == "linh085760@gmail.com" ||
        request.auth.token.email == "phuong026443@stu.vinschool.edu.vn"
      );
    }
    function signedInUser(userId) { return request.auth != null && request.auth.uid == userId; }
    match /users/{userId} {
      allow read: if isAdmin() || signedInUser(userId);
      allow create, update: if isAdmin() || signedInUser(userId);
      allow delete: if isAdmin();
      match /homeworkProgress/{homeworkId} {
        allow read, create, update: if isAdmin() || signedInUser(userId);
        allow delete: if isAdmin() || signedInUser(userId);
      }
      match /achievements/{achievementId} {
        allow read: if isAdmin() || signedInUser(userId);
        allow create, update: if isAdmin() || signedInUser(userId);
        allow delete: if isAdmin() || signedInUser(userId);
      }
      match /inventory/{itemId} {
        allow read: if isAdmin() || signedInUser(userId);
        allow create, update: if isAdmin() || signedInUser(userId);
        allow delete: if isAdmin() || signedInUser(userId);
      }
    }
    match /subjects/{subjectId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /homework/{homeworkId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /settings/{settingId} { allow read: if true; allow write: if isAdmin(); }
    match /achievements/{id} { allow read: if true; allow write: if isAdmin(); }
    match /items/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pets/{id} { allow read: if true; allow write: if isAdmin(); }
    match /themes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
