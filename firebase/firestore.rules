rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "028riu@gmail.com";
    }

    // Everyone can read homework and subject tabs.
    // Only the admin account can create, edit, or delete data.
    match /subjects/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /homework/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
