rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // DANH SÁCH ADMIN
    // =====================================================

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email == "028riu@gmail.com"
          || request.auth.token.email == "tu0ngtun2gsahur8@gmail.com"
        );
    }


    // =====================================================
    // NGƯỜI DÙNG
    // =====================================================

    match /users/{userId} {

      // Admin xem tất cả.
      // Người dùng chỉ xem hồ sơ của chính mình.
      allow read: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == userId
        );

      // Admin tạo được người dùng.
      // Người dùng có thể tạo hồ sơ của chính mình.
      allow create: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == userId
        );

      // Admin sửa tất cả.
      // Người dùng chỉ sửa hồ sơ của chính mình.
      allow update: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == userId
        );

      // Chỉ Admin được xóa người dùng.
      allow delete: if isAdmin();
    }


    // =====================================================
    // MÔN HỌC / TAB
    // =====================================================

    match /subjects/{subjectId} {

      // Ai cũng được xem.
      allow read: if true;

      // Chỉ Admin được tạo / sửa / xóa.
      allow create, update, delete: if isAdmin();
    }


    // =====================================================
    // BÀI TẬP
    // =====================================================

    match /homework/{homeworkId} {

      // Ai cũng được xem.
      allow read: if true;

      // Chỉ Admin được tạo / sửa / xóa.
      allow create, update, delete: if isAdmin();
    }


    // =====================================================
    // CÀI ĐẶT THÔNG BÁO / HỆ THỐNG
    // =====================================================

    match /settings/{settingId} {

      // Chỉ Admin được xem và chỉnh sửa.
      allow read, write: if isAdmin();
    }


    // =====================================================
    // KHÓA MỌI COLLECTION KHÁC
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
